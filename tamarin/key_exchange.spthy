theory key_exchange
begin

builtins: diffie-hellman, symmetric-encryption

// here we start with the knowledge of Idev's pk from Message Announcement
rule Register_pk:
  [ Fr(~ltk_Idev) ]
  -->
  [ !Ltk($Idev, ~ltk_Idev)
  , !Pk($Idev, 'g'^~ltk_Idev) 
  ]

rule Udev_Generate_Ephemeral_Key_Pair:
  [ Fr(~ephSk_Udev) ]
  --[ GenerateEphemeralKeyPair($Udev) ]->
  [ !EphemeralPrivateKey($Udev, ~ephSk_Udev)
  , !EphemeralPublicKey($Udev, 'g'^~ephSk_Udev)
  ]

rule Udev_Compute_Shared_Secret:
  let ss = pk_Idev^~ephSk_Udev 
  in
  [ !EphemeralPrivateKey($Udev, ~ephSk_Udev)
  , !Pk($Idev, pk_Idev) 
  ] 
  --[ ComputeSharedSecret_Udev($Udev, $Idev, ss) ]->
  [ !SharedSecret($Udev, $Idev, ss) ]

rule Udev_Encrypt_And_Send_Message:
  let ephPk_Udev = 'g'^~ephSk_Udev
      msg = senc(~sts_params, ss)
  in
  [ !SharedSecret($Udev, $Idev, ss)
  , Fr(~sts_params)
  , !EphemeralPrivateKey($Udev, ~ephSk_Udev)
  ]
  --[ Secret(~sts_params), EncryptAndSendMessage($Udev, msg, ephPk_Udev) ]->
  [ Out(<msg, ephPk_Udev>) ]

rule Idev_Receive_Compute_Decrypt:
  let ss = ephPk_Udev^~ltk_Idev
      sts_params = sdec(msg, ss)
  in
  [ !Ltk($Idev, ~ltk_Idev)
  , In(<msg, ephPk_Udev>) 
  ] 
  --[ ComputeSharedSecret_Idev($Idev, $Udev, ss), DecryptMessage($Idev, sts_params) ]->
  [ DecryptedMessage(sts_params) ]


lemma full_trace_executable:
  exists-trace
    "Ex Udev Idev params ss ephPk #compU #compI #send #recv.
     ComputeSharedSecret_Udev(Udev, Idev, ss) @ #compU &
     EncryptAndSendMessage(Udev, senc(params, ss), ephPk) @ #send &
     ComputeSharedSecret_Idev(Idev, Udev, ss) @ #compI & 
     DecryptMessage(Idev, params) @ #recv &
     #recv < compI &
     #compU < #send & 
     #send < #recv"

lemma sts_params_confidentiality:
  all-traces
  "All sts_params #i #j. Secret(sts_params) @ #i & K(sts_params) @ #j ==> F"

end